<?xml version="1.0" encoding="utf-8"?>
<!-- Privileged permissions the stock allowlists do not cover on Android 15. -->
<permissions>
    <!-- Stock shipped FMRadioService as a non-privileged app; here it is a priv-app. -->
    <privapp-permissions package="com.motorola.android.fmradio">
        <permission name="android.permission.ACCESS_BROADCAST_RADIO" />
        <permission name="android.permission.MODIFY_AUDIO_ROUTING" />
    </privapp-permissions>
    <privapp-permissions package="com.motorola.faceunlock">
        <permission name="android.permission.SCHEDULE_EXACT_ALARM" />
    </privapp-permissions>
</permissions>
